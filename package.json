{
  "name": "livetranslate-webgpu",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-native, WebGPU-powered real-time subtitle overlay for YouTube embeds — a SvelteKit + Svelte 5 port of LiveTranslate.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:docker": "docker build -f Dockerfile.test -t livetranslate-tests . && docker run --rm --ipc=host livetranslate-tests",
    "screenshot": "npm run build && node scripts/readme-screenshot.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.0",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "onnxruntime-web": "^1.26.0-dev.20260416-b7804b056c"
  }
}
