# Hermetic test runner: type-check (svelte-check), unit/component tests
# (Vitest, includes the real-model Silero ONNX integration test — the model is
# fetched into .model-cache/ at image build time; no model files live in the
# repo), and the Playwright e2e suite, all in one image.
#
# The base image version MUST match the @playwright/test version in bun.lock —
# the image ships the exact browser builds that library version expects, so no
# `playwright install` is needed.
FROM mcr.microsoft.com/playwright:v1.61.1-noble

# Bun drives installs and package scripts; the Vitest/Playwright binaries still
# execute under the image's Node runtime via their shebangs.
COPY --from=oven/bun:1.3.14 /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /app

# Dependency layer first so source-only changes don't re-run bun install.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Fetch the Silero model for the real-model integration test and the offline
# e2e test (its own layer, so source changes don't re-download the weights).
COPY scripts/fetch-silero.mjs scripts/
RUN node scripts/fetch-silero.mjs

COPY . .

# The e2e webServer builds the app and serves it on :4173 internally, so this
# needs no network beyond what the tests stub. Run with --ipc=host: Chromium
# can exhaust a container's default /dev/shm.
CMD ["bash", "-c", "bun run check && bun run test && bun run test:e2e"]
